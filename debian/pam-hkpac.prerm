#!/bin/sh

set -e

PAM_LIGHTDM=/etc/pam.d/lightdm

# 卸载/反配置时把本模块从 /etc/pam.d/lightdm 摘掉，恢复登录栈原样
remove_line() {
    [ -f "$PAM_LIGHTDM" ] || return 0
    grep -q 'pam_hkpac\.so' "$PAM_LIGHTDM" || return 0

    tmp="$(mktemp)"
    grep -v 'pam_hkpac\.so' "$PAM_LIGHTDM" > "$tmp" || true
    cat "$tmp" > "$PAM_LIGHTDM"
    rm -f "$tmp"
}

case "$1" in
    remove|deconfigure|purge)
        remove_line
        ;;
esac

exit 0
